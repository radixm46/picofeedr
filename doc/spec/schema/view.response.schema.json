{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "error"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "error": {
            "not": {
              "type": "null"
            }
          },
          "result": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "ok",
              "warning"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "error": {
            "type": "null"
          },
          "result": {
            "not": {
              "type": "null"
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "EntryDetail": {
      "description": "Entry detail payload.",
      "properties": {
        "author": {
          "description": "Entry author.",
          "type": [
            "string",
            "null"
          ]
        },
        "content": {
          "description": "Entry content body.",
          "type": [
            "string",
            "null"
          ]
        },
        "content_type": {
          "description": "Content type.",
          "type": [
            "string",
            "null"
          ]
        },
        "enclosures": {
          "description": "Enclosure list.",
          "items": {
            "$ref": "#/definitions/EntryEnclosure"
          },
          "type": "array"
        },
        "feed_id": {
          "description": "Feed id.",
          "format": "int64",
          "type": "integer"
        },
        "feed_title": {
          "description": "Feed title.",
          "type": [
            "string",
            "null"
          ]
        },
        "first_seen_at": {
          "description": "First seen time.",
          "format": "int64",
          "type": "integer"
        },
        "id": {
          "description": "Entry id.",
          "format": "int64",
          "type": "integer"
        },
        "link": {
          "description": "Entry link.",
          "type": [
            "string",
            "null"
          ]
        },
        "published_at": {
          "description": "Published time.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "tags": {
          "description": "Tags applied to the entry.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "title": {
          "description": "Entry title.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "enclosures",
        "feed_id",
        "first_seen_at",
        "id",
        "tags"
      ],
      "type": "object"
    },
    "EntryEnclosure": {
      "description": "Entry enclosure payload.",
      "properties": {
        "length": {
          "description": "Length in bytes.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "mime_type": {
          "description": "MIME type.",
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "description": "Enclosure URL.",
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "type": "object"
    },
    "ErrorPayload": {
      "description": "JSON error payload fields.",
      "properties": {
        "code": {
          "description": "Error code string.",
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "description": "Optional machine-readable details for error-specific branching.",
          "type": [
            "object",
            "null"
          ]
        },
        "message": {
          "description": "Human-readable message.",
          "type": "string"
        },
        "retryable": {
          "description": "Whether the caller should retry.",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "type": "object"
    },
    "ResponseMeta": {
      "description": "Metadata returned on every JSON response.",
      "properties": {
        "api_version": {
          "description": "Current CLI API version.",
          "type": "string"
        },
        "db_schema_version": {
          "description": "Current database schema version.",
          "format": "int64",
          "type": "integer"
        },
        "generated_at": {
          "description": "Epoch seconds when the response was generated.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "api_version",
        "db_schema_version",
        "generated_at"
      ],
      "type": "object"
    },
    "ResponseStatus": {
      "description": "Status of the response.",
      "oneOf": [
        {
          "description": "Command completed without warnings.",
          "enum": [
            "ok"
          ],
          "type": "string"
        },
        {
          "description": "Command completed with non-fatal warnings.",
          "enum": [
            "warning"
          ],
          "type": "string"
        },
        {
          "description": "Command failed fatally.",
          "enum": [
            "error"
          ],
          "type": "string"
        }
      ]
    }
  },
  "description": "CLI response envelope for `--output json`.\n\nThis format is stable and intended for UI/automation clients.",
  "properties": {
    "error": {
      "anyOf": [
        {
          "$ref": "#/definitions/ErrorPayload"
        },
        {
          "type": "null"
        }
      ],
      "description": "Error payload when `status=error`, otherwise `null`."
    },
    "meta": {
      "allOf": [
        {
          "$ref": "#/definitions/ResponseMeta"
        }
      ],
      "description": "Response metadata."
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/definitions/EntryDetail"
        },
        {
          "type": "null"
        }
      ],
      "description": "Command payload when `status` is `ok` or `warning`, otherwise `null`."
    },
    "status": {
      "allOf": [
        {
          "$ref": "#/definitions/ResponseStatus"
        }
      ],
      "description": "Status of the command outcome."
    }
  },
  "required": [
    "status",
    "result",
    "error",
    "meta"
  ],
  "title": "Envelope_for_EntryDetail",
  "type": "object"
}