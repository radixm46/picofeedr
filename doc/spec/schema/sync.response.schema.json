{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Envelope_for_SyncSummary",
  "description": "CLI response envelope for `--output json`.\n\nThis format is stable and intended for UI/automation clients.",
  "type": "object",
  "required": [
    "meta",
    "severity",
    "success"
  ],
  "properties": {
    "error": {
      "description": "Error payload when `success=false`, otherwise `null`.",
      "anyOf": [
        {
          "$ref": "#/definitions/ErrorPayload"
        },
        {
          "type": "null"
        }
      ]
    },
    "meta": {
      "description": "Response metadata.",
      "allOf": [
        {
          "$ref": "#/definitions/ResponseMeta"
        }
      ]
    },
    "result": {
      "description": "Command payload when `success=true`, otherwise `null`.",
      "anyOf": [
        {
          "$ref": "#/definitions/SyncSummary"
        },
        {
          "type": "null"
        }
      ]
    },
    "severity": {
      "description": "Severity of the command outcome.",
      "allOf": [
        {
          "$ref": "#/definitions/ResponseSeverity"
        }
      ]
    },
    "success": {
      "description": "Whether the command succeeded.",
      "type": "boolean"
    }
  },
  "definitions": {
    "ErrorPayload": {
      "description": "JSON error payload fields.",
      "type": "object",
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "description": "Error code string.",
          "type": "string"
        },
        "details": {
          "description": "Optional machine-readable details for error-specific branching."
        },
        "message": {
          "description": "Human-readable message.",
          "type": "string"
        },
        "retryable": {
          "description": "Whether the caller should retry.",
          "type": "boolean"
        }
      }
    },
    "ResponseMeta": {
      "description": "Metadata returned on every JSON response.",
      "type": "object",
      "required": [
        "api_version",
        "generated_at",
        "schema_version"
      ],
      "properties": {
        "api_version": {
          "description": "Current CLI API version.",
          "type": "string"
        },
        "generated_at": {
          "description": "Epoch seconds when the response was generated.",
          "type": "integer",
          "format": "int64"
        },
        "schema_version": {
          "description": "Current database schema version.",
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "ResponseSeverity": {
      "description": "Severity level of the response.",
      "oneOf": [
        {
          "description": "Command completed without warnings.",
          "type": "string",
          "enum": [
            "ok"
          ]
        },
        {
          "description": "Command completed with non-fatal warnings.",
          "type": "string",
          "enum": [
            "warn"
          ]
        },
        {
          "description": "Command failed fatally.",
          "type": "string",
          "enum": [
            "error"
          ]
        }
      ]
    },
    "SyncError": {
      "description": "Sync error entry for failed feeds.",
      "type": "object",
      "required": [
        "code",
        "feed_url",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "description": "Error code.",
          "allOf": [
            {
              "$ref": "#/definitions/SyncErrorCode"
            }
          ]
        },
        "feed_url": {
          "description": "Feed URL that failed.",
          "type": "string"
        },
        "message": {
          "description": "Error message.",
          "type": "string"
        },
        "retryable": {
          "description": "Whether the caller should retry.",
          "type": "boolean"
        }
      }
    },
    "SyncErrorCode": {
      "description": "Sync error code values.",
      "type": "string",
      "enum": [
        "FETCH_FAILED",
        "PARSE_FAILED"
      ]
    },
    "SyncStatus": {
      "description": "Sync status values.",
      "type": "string",
      "enum": [
        "completed",
        "partial_failed",
        "failed"
      ]
    },
    "SyncSummary": {
      "description": "Sync result summary.",
      "type": "object",
      "required": [
        "duration_ms",
        "errors",
        "failed_feed_count",
        "fetched_feed_count",
        "new_entry_count",
        "status"
      ],
      "properties": {
        "duration_ms": {
          "description": "Elapsed time in milliseconds.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "errors": {
          "description": "Sync errors for failed feeds.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/SyncError"
          }
        },
        "failed_feed_count": {
          "description": "Number of failed feeds.",
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "fetched_feed_count": {
          "description": "Number of feeds fetched.",
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "new_entry_count": {
          "description": "Number of new entries ingested.",
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "status": {
          "description": "Sync status.",
          "allOf": [
            {
              "$ref": "#/definitions/SyncStatus"
            }
          ]
        }
      }
    }
  }
}