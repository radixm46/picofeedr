{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "error"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "error": {
            "not": {
              "type": "null"
            }
          },
          "result": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "ok",
              "warning"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "error": {
            "type": "null"
          },
          "result": {
            "not": {
              "type": "null"
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "ErrorPayload": {
      "description": "JSON error payload fields.",
      "properties": {
        "code": {
          "description": "Error code string.",
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "description": "Optional machine-readable details for error-specific branching.",
          "type": [
            "object",
            "null"
          ]
        },
        "message": {
          "description": "Human-readable message.",
          "type": "string"
        },
        "retryable": {
          "description": "Whether the caller should retry.",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "type": "object"
    },
    "ResponseMeta": {
      "description": "Metadata returned on every JSON response.",
      "properties": {
        "api_version": {
          "description": "Current CLI API version.",
          "type": "string"
        },
        "db_schema_version": {
          "description": "Current database schema version.",
          "format": "int64",
          "type": "integer"
        },
        "generated_at": {
          "description": "Epoch seconds when the response was generated.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "api_version",
        "db_schema_version",
        "generated_at"
      ],
      "type": "object"
    },
    "ResponseStatus": {
      "description": "Status of the response.",
      "oneOf": [
        {
          "description": "Command completed without warnings.",
          "enum": [
            "ok"
          ],
          "type": "string"
        },
        {
          "description": "Command completed with non-fatal warnings.",
          "enum": [
            "warning"
          ],
          "type": "string"
        },
        {
          "description": "Command failed fatally.",
          "enum": [
            "error"
          ],
          "type": "string"
        }
      ]
    },
    "SyncError": {
      "description": "Sync error entry for failed feeds.",
      "properties": {
        "code": {
          "allOf": [
            {
              "$ref": "#/definitions/SyncErrorCode"
            }
          ],
          "description": "Error code."
        },
        "feed_url": {
          "description": "Feed URL that failed.",
          "type": "string"
        },
        "message": {
          "description": "Error message.",
          "type": "string"
        },
        "retryable": {
          "description": "Whether the caller should retry.",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "feed_url",
        "message",
        "retryable"
      ],
      "type": "object"
    },
    "SyncErrorCode": {
      "description": "Sync error code values.",
      "enum": [
        "FETCH_FAILED",
        "PARSE_FAILED",
        "INGEST_FAILED"
      ],
      "type": "string"
    },
    "SyncStatus": {
      "description": "Sync status values.",
      "enum": [
        "completed",
        "partial_failed",
        "failed"
      ],
      "type": "string"
    },
    "SyncSummary": {
      "description": "Sync result summary.",
      "properties": {
        "duration_ms": {
          "description": "Elapsed time in milliseconds.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "errors": {
          "description": "Sync errors for failed feeds.",
          "items": {
            "$ref": "#/definitions/SyncError"
          },
          "type": "array"
        },
        "failed_feed_count": {
          "description": "Number of failed feeds.",
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "fetched_feed_count": {
          "description": "Number of feeds fetched.",
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "new_entry_count": {
          "description": "Number of new entries ingested.",
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "status": {
          "allOf": [
            {
              "$ref": "#/definitions/SyncStatus"
            }
          ],
          "description": "Sync status."
        }
      },
      "required": [
        "duration_ms",
        "errors",
        "failed_feed_count",
        "fetched_feed_count",
        "new_entry_count",
        "status"
      ],
      "type": "object"
    }
  },
  "description": "CLI response envelope for `--output json`.\n\nThis format is stable and intended for UI/automation clients.",
  "properties": {
    "error": {
      "anyOf": [
        {
          "$ref": "#/definitions/ErrorPayload"
        },
        {
          "type": "null"
        }
      ],
      "description": "Error payload when `status=error`, otherwise `null`."
    },
    "meta": {
      "allOf": [
        {
          "$ref": "#/definitions/ResponseMeta"
        }
      ],
      "description": "Response metadata."
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/definitions/SyncSummary"
        },
        {
          "type": "null"
        }
      ],
      "description": "Command payload when `status` is `ok` or `warning`, otherwise `null`."
    },
    "status": {
      "allOf": [
        {
          "$ref": "#/definitions/ResponseStatus"
        }
      ],
      "description": "Status of the command outcome."
    }
  },
  "required": [
    "status",
    "result",
    "error",
    "meta"
  ],
  "title": "Envelope_for_SyncSummary",
  "type": "object"
}