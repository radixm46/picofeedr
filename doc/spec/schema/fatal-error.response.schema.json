{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "error"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "error": {
            "not": {
              "type": "null"
            }
          },
          "result": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "ok",
              "warning"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "error": {
            "type": "null"
          },
          "result": {
            "not": {
              "type": "null"
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "ErrorPayload": {
      "description": "JSON error payload fields.",
      "properties": {
        "code": {
          "description": "Error code string.",
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "description": "Optional machine-readable details for error-specific branching.",
          "type": [
            "object",
            "null"
          ]
        },
        "message": {
          "description": "Human-readable message.",
          "type": "string"
        },
        "retryable": {
          "description": "Whether the caller should retry.",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "type": "object"
    },
    "FatalStatus": {
      "description": "Fatal status fixed literal.",
      "oneOf": [
        {
          "description": "Fixed status string.",
          "enum": [
            "error"
          ],
          "type": "string"
        }
      ]
    },
    "ResponseMeta": {
      "description": "Metadata returned on every JSON response.",
      "properties": {
        "api_version": {
          "description": "Current CLI API version.",
          "type": "string"
        },
        "db_schema_version": {
          "description": "Current database schema version.",
          "format": "int64",
          "type": "integer"
        },
        "generated_at": {
          "description": "Epoch seconds when the response was generated.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "api_version",
        "db_schema_version",
        "generated_at"
      ],
      "type": "object"
    }
  },
  "description": "Fatal-only envelope schema.",
  "properties": {
    "error": {
      "allOf": [
        {
          "$ref": "#/definitions/ErrorPayload"
        }
      ],
      "description": "Fatal error payload."
    },
    "meta": {
      "allOf": [
        {
          "$ref": "#/definitions/ResponseMeta"
        }
      ],
      "description": "Common response metadata."
    },
    "result": {
      "description": "Always null for fatal responses.",
      "type": "null"
    },
    "status": {
      "allOf": [
        {
          "$ref": "#/definitions/FatalStatus"
        }
      ],
      "description": "Always `error` for fatal responses."
    }
  },
  "required": [
    "status",
    "result",
    "error",
    "meta"
  ],
  "title": "FatalErrorEnvelope",
  "type": "object"
}