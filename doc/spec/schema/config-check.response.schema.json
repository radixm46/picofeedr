{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "error"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "error": {
            "not": {
              "type": "null"
            }
          },
          "result": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "ok",
              "warning"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "error": {
            "type": "null"
          },
          "result": {
            "not": {
              "type": "null"
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "ConfigCheckReport": {
      "description": "Static validation report for `feeds --config-check`.",
      "properties": {
        "checked_feeds": {
          "description": "Number of feed entries checked.",
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "errors": {
          "description": "Validation errors that should fail the command.",
          "items": {
            "$ref": "#/definitions/ValidationIssue"
          },
          "type": "array"
        },
        "valid": {
          "description": "True when no validation errors are present.",
          "type": "boolean"
        },
        "warnings": {
          "description": "Validation warnings that do not fail the command.",
          "items": {
            "$ref": "#/definitions/ValidationIssue"
          },
          "type": "array"
        }
      },
      "required": [
        "checked_feeds",
        "errors",
        "valid",
        "warnings"
      ],
      "type": "object"
    },
    "ErrorPayload": {
      "description": "JSON error payload fields.",
      "properties": {
        "code": {
          "description": "Error code string.",
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "description": "Optional machine-readable details for error-specific branching.",
          "type": [
            "object",
            "null"
          ]
        },
        "message": {
          "description": "Human-readable message.",
          "type": "string"
        },
        "retryable": {
          "description": "Whether the caller should retry.",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "type": "object"
    },
    "ResponseMeta": {
      "description": "Metadata returned on every JSON response.",
      "properties": {
        "api_version": {
          "description": "Current CLI API version.",
          "type": "string"
        },
        "db_schema_version": {
          "description": "Current database schema version.",
          "format": "int64",
          "type": "integer"
        },
        "generated_at": {
          "description": "Epoch seconds when the response was generated.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "api_version",
        "db_schema_version",
        "generated_at"
      ],
      "type": "object"
    },
    "ResponseStatus": {
      "description": "Status of the response.",
      "oneOf": [
        {
          "description": "Command completed without warnings.",
          "enum": [
            "ok"
          ],
          "type": "string"
        },
        {
          "description": "Command completed with non-fatal warnings.",
          "enum": [
            "warning"
          ],
          "type": "string"
        },
        {
          "description": "Command failed fatally.",
          "enum": [
            "error"
          ],
          "type": "string"
        }
      ]
    },
    "ValidationIssue": {
      "description": "Static validation issue for feeds config check.",
      "properties": {
        "code": {
          "description": "Machine-readable issue code.",
          "type": "string"
        },
        "message": {
          "description": "Human-readable issue details.",
          "type": "string"
        },
        "path": {
          "description": "Logical path in feeds.yaml where the issue was detected.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    }
  },
  "description": "CLI response envelope for `--output json`.\n\nThis format is stable and intended for UI/automation clients.",
  "properties": {
    "error": {
      "anyOf": [
        {
          "$ref": "#/definitions/ErrorPayload"
        },
        {
          "type": "null"
        }
      ],
      "description": "Error payload when `status=error`, otherwise `null`."
    },
    "meta": {
      "allOf": [
        {
          "$ref": "#/definitions/ResponseMeta"
        }
      ],
      "description": "Response metadata."
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/definitions/ConfigCheckReport"
        },
        {
          "type": "null"
        }
      ],
      "description": "Command payload when `status` is `ok` or `warning`, otherwise `null`."
    },
    "status": {
      "allOf": [
        {
          "$ref": "#/definitions/ResponseStatus"
        }
      ],
      "description": "Status of the command outcome."
    }
  },
  "required": [
    "status",
    "result",
    "error",
    "meta"
  ],
  "title": "Envelope_for_ConfigCheckReport",
  "type": "object"
}