{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "error"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "error": {
            "not": {
              "type": "null"
            }
          },
          "result": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "ok",
              "warning"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "error": {
            "type": "null"
          },
          "result": {
            "not": {
              "type": "null"
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "EntryListResponse": {
      "description": "Entry list response payload.",
      "properties": {
        "feeds": {
          "description": "Feed dictionary for feed id to title mapping.",
          "items": {
            "$ref": "#/definitions/FeedSummary"
          },
          "type": "array"
        },
        "items": {
          "description": "Page items.",
          "items": {
            "$ref": "#/definitions/EntrySummary"
          },
          "type": "array"
        },
        "last_write_at": {
          "description": "Write timestamp captured when the list was fetched.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "next_page_token": {
          "description": "Cursor for the next page.",
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "description": "Revision captured when the list was fetched.",
          "format": "int64",
          "type": "integer"
        },
        "total_count": {
          "description": "Total hits for the query.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "total_count",
        "items",
        "feeds",
        "revision"
      ],
      "type": "object"
    },
    "EntrySummary": {
      "description": "Entry summary for list responses.",
      "properties": {
        "entry_id": {
          "description": "Entry id.",
          "type": "string"
        },
        "feed_id": {
          "description": "Feed id.",
          "type": "string"
        },
        "first_seen_at": {
          "description": "First seen time.",
          "format": "int64",
          "type": "integer"
        },
        "link": {
          "description": "Entry link.",
          "type": [
            "string",
            "null"
          ]
        },
        "published_at": {
          "description": "Published time.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "tags": {
          "description": "Tags applied to the entry.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "title": {
          "description": "Entry title.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "entry_id",
        "feed_id",
        "first_seen_at",
        "tags"
      ],
      "type": "object"
    },
    "ErrorPayload": {
      "description": "JSON error payload fields.",
      "properties": {
        "code": {
          "description": "Error code string.",
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "description": "Optional machine-readable details for error-specific branching.",
          "type": [
            "object",
            "null"
          ]
        },
        "message": {
          "description": "Human-readable message.",
          "type": "string"
        },
        "retryable": {
          "description": "Whether the caller should retry.",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "type": "object"
    },
    "FeedSummary": {
      "description": "Feed dictionary item used by entry list responses.",
      "properties": {
        "feed_id": {
          "description": "Feed id.",
          "type": "string"
        },
        "title": {
          "description": "Feed title.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "feed_id"
      ],
      "type": "object"
    },
    "ResponseMeta": {
      "description": "Metadata returned on every JSON response.",
      "properties": {
        "api_version": {
          "description": "Current CLI API version.",
          "type": "string"
        },
        "db_schema_version": {
          "description": "Current database schema version.",
          "format": "int64",
          "type": "integer"
        },
        "generated_at": {
          "description": "Epoch seconds when the response was generated.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "api_version",
        "db_schema_version",
        "generated_at"
      ],
      "type": "object"
    },
    "ResponseStatus": {
      "description": "Status of the response.",
      "oneOf": [
        {
          "const": "ok",
          "description": "Command completed without warnings.",
          "type": "string"
        },
        {
          "const": "warning",
          "description": "Command completed with non-fatal warnings.",
          "type": "string"
        },
        {
          "const": "error",
          "description": "Command failed fatally.",
          "type": "string"
        }
      ]
    }
  },
  "description": "CLI response envelope for `--output json`.\n\nThis format is stable and intended for UI/automation clients.",
  "properties": {
    "error": {
      "anyOf": [
        {
          "$ref": "#/definitions/ErrorPayload"
        },
        {
          "type": "null"
        }
      ],
      "description": "Error payload when `status=error`, otherwise `null`."
    },
    "meta": {
      "allOf": [
        {
          "$ref": "#/definitions/ResponseMeta"
        }
      ],
      "description": "Response metadata."
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/definitions/EntryListResponse"
        },
        {
          "type": "null"
        }
      ],
      "description": "Command payload when `status` is `ok` or `warning`, otherwise `null`."
    },
    "status": {
      "allOf": [
        {
          "$ref": "#/definitions/ResponseStatus"
        }
      ],
      "description": "Status of the command outcome."
    }
  },
  "required": [
    "status",
    "result",
    "error",
    "meta"
  ],
  "title": "Envelope",
  "type": "object"
}